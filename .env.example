APP_NAME="GitHub Exam Onboarding"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=classroom_lock
DB_USERNAME=root
DB_PASSWORD=

# --- GitHub App (see README) ---------------------------------------------------
GITHUB_ORGANIZATION=curio-summatief
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Absolute, or relative to the project root. *.pem files are gitignored.
GITHUB_APP_PRIVATE_KEY_PATH=
# Client ID (starts with Iv) and a client secret of the same app, for "Sign in with GitHub".
# Register {APP_URL}/join/github/callback as Callback URL in the app settings.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Fallback instead of the app: token of an organization owner.
GITHUB_TOKEN=

# --- Limits --------------------------------------------------------------------
# 500 for orgs older than a month or on a paid plan, otherwise 50.
GITHUB_INVITATIONS_PER_DAY=500
INVITE_LINK_DAYS=14

SD_CLIENT_ID=
SD_CLIENT_SECRET=
SD_APP_FOR=teachers

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# Provisioning and offboarding run as queued jobs: run `php artisan queue:work`.
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
